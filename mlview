-- ============================================================
-- 3.3 EUR CİNSİNDEN MALİYET
-- 
-- Tüm kayıtları kendi tarihindeki kurla EUR'a çevirir
-- TL kayıtlarda DOVFIAT=0 ise NF/GCMIK kullanılır
-- ============================================================
CREATE FUNCTION dbo.fn_MaliyetEUR
(
    @STOK_KODU VARCHAR(50),
    @BASLANGIC DATETIME,
    @BITIS DATETIME
)
RETURNS DECIMAL(28, 15)
AS
BEGIN
    DECLARE @Result DECIMAL(28, 15) = 0
    
    -- Her kayıt kendi tarihindeki kurla EUR'a çevrilir
    SELECT @Result = 
        SUM(STHAR_GCMIK * 
            CASE ISNULL(STHAR_DOVTIP, 0)
                WHEN 0 THEN  -- TL -> EUR
                    CASE 
                        WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT / dbo.fn_Kur(STHAR_TARIH, 1)
                        WHEN ISNULL(STHAR_NF, 0) > 0 THEN (STHAR_NF / STHAR_GCMIK) / dbo.fn_Kur(STHAR_TARIH, 1)
                        ELSE 0
                    END
                WHEN 1 THEN STHAR_DOVFIAT  -- EUR -> EUR
                WHEN 2 THEN STHAR_DOVFIAT * dbo.fn_Parite(STHAR_TARIH, 2, 1)  -- USD -> EUR
            END
        ) / NULLIF(SUM(STHAR_GCMIK), 0)
    FROM dbo.TBLSTHAR
    WHERE STOK_KODU = @STOK_KODU
      AND STHAR_GCKOD = 'G'
      AND STHAR_HTUR = 'J'
      AND STHAR_TARIH >= @BASLANGIC
      AND STHAR_TARIH <= @BITIS
      AND STHAR_GCMIK > 0
      AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)
    
    -- Fallback
    IF ISNULL(@Result, 0) = 0
    BEGIN
        SELECT TOP 1 @Result = 
            CASE ISNULL(STHAR_DOVTIP, 0)
                WHEN 0 THEN
                    CASE 
                        WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT / dbo.fn_Kur(STHAR_TARIH, 1)
                        WHEN ISNULL(STHAR_NF, 0) > 0 THEN (STHAR_NF / STHAR_GCMIK) / dbo.fn_Kur(STHAR_TARIH, 1)
                        ELSE 0
                    END
                WHEN 1 THEN STHAR_DOVFIAT
                WHEN 2 THEN STHAR_DOVFIAT * dbo.fn_Parite(STHAR_TARIH, 2, 1)
            END
        FROM dbo.TBLSTHAR
        WHERE STOK_KODU = @STOK_KODU
          AND STHAR_GCKOD = 'G'
          AND STHAR_HTUR = 'J'
          AND STHAR_GCMIK > 0
          AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)
        ORDER BY STHAR_TARIH DESC
    END
    
    RETURN ISNULL(@Result, 0)
END
GO

-- ============================================================
-- 3.4 İSTENEN DÖVİZE ÇEVRİLMİŞ MALİYET
-- 
-- Tüm kayıtları kendi tarihindeki kurla hedef dövize çevirir
-- TL kayıtlarda DOVFIAT=0 ise NF/GCMIK kullanılır
-- ============================================================
CREATE FUNCTION dbo.fn_MaliyetCevir
(
    @STOK_KODU VARCHAR(50),
    @BASLANGIC DATETIME,
    @BITIS DATETIME,
    @HEDEF_DOVTIP TINYINT
)
RETURNS DECIMAL(28, 15)
AS
BEGIN
    DECLARE @Result DECIMAL(28, 15) = 0
    
    -- Her kayıt kendi tarihindeki kurla hedef dövize çevrilir
    SELECT @Result = 
        SUM(STHAR_GCMIK * 
            CASE ISNULL(STHAR_DOVTIP, 0)
                WHEN 0 THEN  -- TL kayıt
                    CASE 
                        WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN 
                            CASE @HEDEF_DOVTIP
                                WHEN 0 THEN STHAR_DOVFIAT  -- TL -> TL
                                ELSE STHAR_DOVFIAT / dbo.fn_Kur(STHAR_TARIH, @HEDEF_DOVTIP)  -- TL -> Döviz
                            END
                        WHEN ISNULL(STHAR_NF, 0) > 0 THEN 
                            CASE @HEDEF_DOVTIP
                                WHEN 0 THEN STHAR_NF / STHAR_GCMIK  -- NF -> TL
                                ELSE (STHAR_NF / STHAR_GCMIK) / dbo.fn_Kur(STHAR_TARIH, @HEDEF_DOVTIP)  -- NF -> Döviz
                            END
                        ELSE 0
                    END
                WHEN 1 THEN  -- EUR kayıt
                    CASE @HEDEF_DOVTIP
                        WHEN 0 THEN STHAR_DOVFIAT * dbo.fn_Kur(STHAR_TARIH, 1)  -- EUR -> TL
                        WHEN 1 THEN STHAR_DOVFIAT  -- EUR -> EUR
                        WHEN 2 THEN STHAR_DOVFIAT * dbo.fn_Kur(STHAR_TARIH, 1) / dbo.fn_Kur(STHAR_TARIH, 2)  -- EUR -> USD
                    END
                WHEN 2 THEN  -- USD kayıt
                    CASE @HEDEF_DOVTIP
                        WHEN 0 THEN STHAR_DOVFIAT * dbo.fn_Kur(STHAR_TARIH, 2)  -- USD -> TL
                        WHEN 1 THEN STHAR_DOVFIAT * dbo.fn_Kur(STHAR_TARIH, 2) / dbo.fn_Kur(STHAR_TARIH, 1)  -- USD -> EUR
                        WHEN 2 THEN STHAR_DOVFIAT  -- USD -> USD
                    END
            END
        ) / NULLIF(SUM(STHAR_GCMIK), 0)
    FROM dbo.TBLSTHAR
    WHERE STOK_KODU = @STOK_KODU
      AND STHAR_GCKOD = 'G'
      AND STHAR_HTUR = 'J'
      AND STHAR_TARIH >= @BASLANGIC
      AND STHAR_TARIH <= @BITIS
      AND STHAR_GCMIK > 0
      AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)
    
    RETURN ISNULL(@Result, 0)
END
GO

-- ============================================================
-- 3.5 FIFO MALİYET
-- 
-- First In First Out yöntemiyle stok maliyeti hesaplar
-- Girişler: GCKOD='G' AND HTUR IN ('C', 'J', 'H')
-- Çıkışlar: GCKOD='C' AND HTUR IN ('C', 'J', 'H')
-- 
-- @STOK_KODU  : Stok kodu
-- @TARIH      : Bu tarihe kadar hesapla
-- @DOVTIP     : Döviz tipi (0:TL, 1:EUR, 2:USD)
-- ============================================================
CREATE FUNCTION dbo.fn_MaliyetFIFO
(
    @STOK_KODU VARCHAR(50),
    @TARIH DATETIME,
    @DOVTIP TINYINT = NULL  -- NULL ise stokun kendi dövizi
)
RETURNS DECIMAL(28, 15)
AS
BEGIN
    IF @DOVTIP IS NULL
        SET @DOVTIP = dbo.fn_StokDovizTip(@STOK_KODU)
    
    DECLARE @Result DECIMAL(28, 15) = 0
    DECLARE @KalanCikis DECIMAL(28, 15) = 0
    DECLARE @ToplamDeger DECIMAL(28, 15) = 0
    DECLARE @ToplamMiktar DECIMAL(28, 15) = 0
    
    -- Toplam çıkış miktarı (GCKOD='C' AND HTUR IN ('C','J','H'))
    SELECT @KalanCikis = ISNULL(SUM(STHAR_GCMIK), 0)
    FROM dbo.TBLSTHAR
    WHERE STOK_KODU = @STOK_KODU
      AND STHAR_GCKOD = 'C'
      AND STHAR_HTUR IN ('C', 'J', 'H')
      AND STHAR_TARIH <= @TARIH
      AND STHAR_GCMIK > 0
    
    -- Girişleri tarih sırasıyla işle, çıkışları düş
    -- Kalan miktar ve değeri hesapla
    ;WITH Girisler AS (
        SELECT 
            STHAR_TARIH,
            STHAR_GCMIK AS MIKTAR,
            CASE 
                WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN
                    CASE ISNULL(STHAR_DOVTIP, 0)
                        WHEN @DOVTIP THEN STHAR_DOVFIAT
                        WHEN 0 THEN STHAR_DOVFIAT / dbo.fn_Kur(STHAR_TARIH, @DOVTIP)
                        ELSE STHAR_DOVFIAT * dbo.fn_Kur(STHAR_TARIH, ISNULL(STHAR_DOVTIP, 0)) / dbo.fn_Kur(STHAR_TARIH, @DOVTIP)
                    END
                WHEN ISNULL(STHAR_NF, 0) > 0 THEN
                    CASE @DOVTIP
                        WHEN 0 THEN STHAR_NF / STHAR_GCMIK
                        ELSE (STHAR_NF / STHAR_GCMIK) / dbo.fn_Kur(STHAR_TARIH, @DOVTIP)
                    END
                ELSE 0
            END AS BIRIM_FIYAT,
            ROW_NUMBER() OVER (ORDER BY STHAR_TARIH ASC, INCKEYNO ASC) AS SIRA
        FROM dbo.TBLSTHAR
        WHERE STOK_KODU = @STOK_KODU
          AND STHAR_GCKOD = 'G'
          AND STHAR_HTUR IN ('C', 'J', 'H')
          AND STHAR_TARIH <= @TARIH
          AND STHAR_GCMIK > 0
          AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)
    ),
    FIFO_Hesap AS (
        SELECT 
            SIRA,
            MIKTAR,
            BIRIM_FIYAT,
            -- Kümülatif miktar
            SUM(MIKTAR) OVER (ORDER BY SIRA) AS KUMULATIF_MIKTAR
        FROM Girisler
    ),
    Kalan AS (
        SELECT 
            SIRA,
            MIKTAR,
            BIRIM_FIYAT,
            KUMULATIF_MIKTAR,
            -- Bu girişten kalan miktar
            CASE 
                WHEN KUMULATIF_MIKTAR <= @KalanCikis THEN 0  -- Tamamen tüketildi
                WHEN KUMULATIF_MIKTAR - MIKTAR >= @KalanCikis THEN MIKTAR  -- Hiç tüketilmedi
                ELSE KUMULATIF_MIKTAR - @KalanCikis  -- Kısmen tüketildi
            END AS KALAN_MIKTAR
        FROM FIFO_Hesap
    )
    SELECT 
        @ToplamMiktar = SUM(KALAN_MIKTAR),
        @ToplamDeger = SUM(KALAN_MIKTAR * BIRIM_FIYAT)
    FROM Kalan
    WHERE KALAN_MIKTAR > 0
    
    IF ISNULL(@ToplamMiktar, 0) > 0
        SET @Result = @ToplamDeger / @ToplamMiktar
    
    RETURN ISNULL(@Result, 0)
END
GO

-- ============================================================
-- 3.6 FIFO MALİYET (EUR'a Çevrilmiş)
-- ============================================================
CREATE FUNCTION dbo.fn_MaliyetFIFO_EUR
(
    @STOK_KODU VARCHAR(50),
    @TARIH DATETIME
)
RETURNS DECIMAL(28, 15)
AS
BEGIN
    RETURN dbo.fn_MaliyetFIFO(@STOK_KODU, @TARIH, 1)
END
GO

-- ============================================================
-- 3.7 FIFO MALİYET (Otomatik Döviz)
-- ============================================================
CREATE FUNCTION dbo.fn_MaliyetFIFO_Oto
(
    @STOK_KODU VARCHAR(50),
    @TARIH DATETIME
)
RETURNS DECIMAL(28, 15)
AS
BEGIN
    RETURN dbo.fn_MaliyetFIFO(@STOK_KODU, @TARIH, NULL)
END
GO

-- ============================================================
-- BÖLÜM 3.8: HATA AYIKLAMA VIEW'LARI
-- ============================================================

-- ============================================================
-- vw_FIFO_Detay - FIFO hesabının detayını gösterir
-- Excel'e çekilebilir, STOK_KODU ile filtrelenir
-- ============================================================
CREATE VIEW dbo.vw_FIFO_Detay
AS
WITH ToplamCikislar AS (
    SELECT 
        STOK_KODU,
        ISNULL(SUM(STHAR_GCMIK), 0) AS TOPLAM_CIKIS
    FROM dbo.TBLSTHAR
    WHERE STHAR_GCKOD = 'C'
      AND STHAR_HTUR IN ('C', 'J', 'H')
      AND STHAR_GCMIK > 0
    GROUP BY STOK_KODU
),
Girisler AS (
    SELECT 
        h.STOK_KODU,
        h.INCKEYNO,
        h.FISNO,
        h.STHAR_HTUR AS HTUR,
        h.STHAR_TARIH AS TARIH,
        h.STHAR_GCMIK AS GIRIS_MIKTAR,
        ISNULL(h.STHAR_DOVTIP, 0) AS DOVTIP,
        dbo.fn_DovizAdi(ISNULL(h.STHAR_DOVTIP, 0)) AS DOVIZ,
        h.STHAR_DOVFIAT AS DOVFIAT,
        h.STHAR_NF AS NF,
        CASE 
            WHEN ISNULL(h.STHAR_DOVFIAT, 0) > 0 THEN h.STHAR_DOVFIAT
            WHEN ISNULL(h.STHAR_NF, 0) > 0 THEN h.STHAR_NF / h.STHAR_GCMIK
            ELSE 0
        END AS BIRIM_FIYAT,
        -- EUR'a çevrilmiş fiyat
        CASE ISNULL(h.STHAR_DOVTIP, 0)
            WHEN 0 THEN 
                CASE 
                    WHEN ISNULL(h.STHAR_DOVFIAT, 0) > 0 THEN h.STHAR_DOVFIAT / dbo.fn_Kur(h.STHAR_TARIH, 1)
                    WHEN ISNULL(h.STHAR_NF, 0) > 0 THEN (h.STHAR_NF / h.STHAR_GCMIK) / dbo.fn_Kur(h.STHAR_TARIH, 1)
                    ELSE 0
                END
            WHEN 1 THEN h.STHAR_DOVFIAT
            WHEN 2 THEN h.STHAR_DOVFIAT * dbo.fn_Kur(h.STHAR_TARIH, 2) / dbo.fn_Kur(h.STHAR_TARIH, 1)
        END AS BIRIM_FIYAT_EUR,
        dbo.fn_Kur(h.STHAR_TARIH, 1) AS EUR_KUR,
        dbo.fn_Kur(h.STHAR_TARIH, 2) AS USD_KUR,
        SUM(h.STHAR_GCMIK) OVER (PARTITION BY h.STOK_KODU ORDER BY h.STHAR_TARIH, h.INCKEYNO) AS KUMULATIF_GIRIS,
        ROW_NUMBER() OVER (PARTITION BY h.STOK_KODU ORDER BY h.STHAR_TARIH, h.INCKEYNO) AS SIRA
    FROM dbo.TBLSTHAR h
    WHERE h.STHAR_GCKOD = 'G'
      AND h.STHAR_HTUR IN ('C', 'J', 'H')
      AND h.STHAR_GCMIK > 0
      AND (ISNULL(h.STHAR_DOVFIAT, 0) > 0 OR ISNULL(h.STHAR_NF, 0) > 0)
),
FIFO_Hesap AS (
    SELECT 
        g.*,
        ISNULL(tc.TOPLAM_CIKIS, 0) AS TOPLAM_CIKIS,
        CASE 
            WHEN g.KUMULATIF_GIRIS <= ISNULL(tc.TOPLAM_CIKIS, 0) THEN 0
            WHEN g.KUMULATIF_GIRIS - g.GIRIS_MIKTAR >= ISNULL(tc.TOPLAM_CIKIS, 0) THEN g.GIRIS_MIKTAR
            ELSE g.KUMULATIF_GIRIS - ISNULL(tc.TOPLAM_CIKIS, 0)
        END AS KALAN_MIKTAR,
        CASE 
            WHEN g.KUMULATIF_GIRIS <= ISNULL(tc.TOPLAM_CIKIS, 0) THEN 'TÜKETİLDİ'
            WHEN g.KUMULATIF_GIRIS - g.GIRIS_MIKTAR >= ISNULL(tc.TOPLAM_CIKIS, 0) THEN 'TAM'
            ELSE 'KISMİ'
        END AS DURUM
    FROM Girisler g
    LEFT JOIN ToplamCikislar tc ON g.STOK_KODU = tc.STOK_KODU
)
SELECT 
    STOK_KODU,
    SIRA,
    INCKEYNO,
    FISNO,
    HTUR,
    TARIH,
    DOVTIP,
    DOVIZ,
    DOVFIAT,
    NF,
    BIRIM_FIYAT,
    BIRIM_FIYAT_EUR,
    EUR_KUR,
    USD_KUR,
    GIRIS_MIKTAR,
    KUMULATIF_GIRIS,
    TOPLAM_CIKIS,
    KALAN_MIKTAR,
    DURUM,
    KALAN_MIKTAR * BIRIM_FIYAT AS KALAN_DEGER,
    KALAN_MIKTAR * BIRIM_FIYAT_EUR AS KALAN_DEGER_EUR
FROM FIFO_Hesap
GO

-- ============================================================
-- vw_MA_Detay - MA hesabının detayını gösterir
-- Excel'e çekilebilir, STOK_KODU ile filtrelenir
-- ============================================================
CREATE VIEW dbo.vw_MA_Detay
AS
SELECT 
    h.STOK_KODU,
    h.INCKEYNO,
    h.FISNO,
    h.STHAR_HTUR AS HTUR,
    h.STHAR_TARIH AS TARIH,
    h.STHAR_GCMIK AS MIKTAR,
    ISNULL(h.STHAR_DOVTIP, 0) AS DOVTIP,
    dbo.fn_DovizAdi(ISNULL(h.STHAR_DOVTIP, 0)) AS DOVIZ,
    h.STHAR_DOVFIAT AS DOVFIAT,
    h.STHAR_NF AS NF,
    -- Kullanılan birim fiyat
    CASE 
        WHEN ISNULL(h.STHAR_DOVFIAT, 0) > 0 THEN h.STHAR_DOVFIAT
        WHEN ISNULL(h.STHAR_NF, 0) > 0 THEN h.STHAR_NF / h.STHAR_GCMIK
        ELSE 0
    END AS BIRIM_FIYAT,
    -- Toplam değer
    h.STHAR_GCMIK * CASE 
        WHEN ISNULL(h.STHAR_DOVFIAT, 0) > 0 THEN h.STHAR_DOVFIAT
        WHEN ISNULL(h.STHAR_NF, 0) > 0 THEN h.STHAR_NF / h.STHAR_GCMIK
        ELSE 0
    END AS TOPLAM_DEGER,
    -- EUR'a çevrilmiş
    h.STHAR_GCMIK * CASE ISNULL(h.STHAR_DOVTIP, 0)
        WHEN 0 THEN 
            CASE 
                WHEN ISNULL(h.STHAR_DOVFIAT, 0) > 0 THEN h.STHAR_DOVFIAT / dbo.fn_Kur(h.STHAR_TARIH, 1)
                WHEN ISNULL(h.STHAR_NF, 0) > 0 THEN (h.STHAR_NF / h.STHAR_GCMIK) / dbo.fn_Kur(h.STHAR_TARIH, 1)
                ELSE 0
            END
        WHEN 1 THEN h.STHAR_DOVFIAT
        WHEN 2 THEN h.STHAR_DOVFIAT * dbo.fn_Parite(h.STHAR_TARIH, 2, 1)
    END AS EUR_DEGER,
    dbo.fn_Kur(h.STHAR_TARIH, 1) AS EUR_KUR,
    dbo.fn_Kur(h.STHAR_TARIH, 2) AS USD_KUR
FROM dbo.TBLSTHAR h
WHERE h.STHAR_GCKOD = 'G'
  AND h.STHAR_HTUR = 'J'
  AND h.STHAR_GCMIK > 0
  AND (ISNULL(h.STHAR_DOVFIAT, 0) > 0 OR ISNULL(h.STHAR_NF, 0) > 0)
GO

-- ============================================================
-- vw_Stok_Ozet - Stok bazlı MA ve FIFO özeti
-- Excel'e çekilebilir
-- ============================================================
CREATE VIEW dbo.vw_Stok_Ozet
AS
WITH GirisMiktar AS (
    SELECT 
        STOK_KODU,
        SUM(STHAR_GCMIK) AS TOPLAM_GIRIS
    FROM TBLSTHAR
    WHERE STHAR_GCKOD = 'G'
      AND STHAR_HTUR IN ('C', 'J', 'H')
      AND STHAR_GCMIK > 0
    GROUP BY STOK_KODU
),
CikisMiktar AS (
    SELECT 
        STOK_KODU,
        SUM(STHAR_GCMIK) AS TOPLAM_CIKIS
    FROM TBLSTHAR
    WHERE STHAR_GCKOD = 'C'
      AND STHAR_HTUR IN ('C', 'J', 'H')
      AND STHAR_GCMIK > 0
    GROUP BY STOK_KODU
)
SELECT 
    st.STOK_KODU,
    st.STOK_ADI,
    dbo.fn_StokDovizTip(st.STOK_KODU) AS DOVTIP,
    dbo.fn_DovizAdi(dbo.fn_StokDovizTip(st.STOK_KODU)) AS DOVIZ,
    ISNULL(gm.TOPLAM_GIRIS, 0) AS TOPLAM_GIRIS,
    ISNULL(cm.TOPLAM_CIKIS, 0) AS TOPLAM_CIKIS,
    ISNULL(gm.TOPLAM_GIRIS, 0) - ISNULL(cm.TOPLAM_CIKIS, 0) AS KALAN_MIKTAR,
    dbo.fn_MaliyetFIFO_Oto(st.STOK_KODU, GETDATE()) AS FIFO_BIRIM_MALIYET,
    dbo.fn_MaliyetFIFO_EUR(st.STOK_KODU, GETDATE()) AS FIFO_BIRIM_EUR,
    (ISNULL(gm.TOPLAM_GIRIS, 0) - ISNULL(cm.TOPLAM_CIKIS, 0)) * dbo.fn_MaliyetFIFO_Oto(st.STOK_KODU, GETDATE()) AS FIFO_TOPLAM_DEGER,
    (ISNULL(gm.TOPLAM_GIRIS, 0) - ISNULL(cm.TOPLAM_CIKIS, 0)) * dbo.fn_MaliyetFIFO_EUR(st.STOK_KODU, GETDATE()) AS FIFO_TOPLAM_EUR
FROM TBLSTSABIT st
LEFT JOIN GirisMiktar gm ON st.STOK_KODU = gm.STOK_KODU
LEFT JOIN CikisMiktar cm ON st.STOK_KODU = cm.STOK_KODU
WHERE gm.STOK_KODU IS NOT NULL OR cm.STOK_KODU IS NOT NULL
GO

-- ============================================================
-- BÖLÜM 4: ÜRETİM MALİYET GÜNCELLEME PROSEDÜRÜ
-- ============================================================

CREATE PROCEDURE dbo.sp_UretimMaliyetGuncelle
    @YIL INT = NULL,
    @AY INT = NULL,
    @HEDEF_DOVTIP TINYINT = NULL,          -- NULL: Dinamik, 0:TL, 1:EUR, 2:USD
    @MA_BASLANGIC_TARIH DATETIME = NULL    -- NULL ise 1 yıl önce
AS
BEGIN
    SET NOCOUNT ON;
    
    IF @YIL IS NULL OR @AY IS NULL
    BEGIN
        SET @YIL = YEAR(DATEADD(MONTH, -1, GETDATE()))
        SET @AY = MONTH(DATEADD(MONTH, -1, GETDATE()))
    END
    
    DECLARE @BASLANGIC_TARIH DATETIME = DATEFROMPARTS(@YIL, @AY, 1)
    DECLARE @BITIS_TARIH DATETIME = EOMONTH(@BASLANGIC_TARIH)
    DECLARE @MA_BITIS_TARIH DATETIME = DATEADD(DAY, -1, @BASLANGIC_TARIH)
    
    IF @MA_BASLANGIC_TARIH IS NULL
        SET @MA_BASLANGIC_TARIH = DATEADD(YEAR, -1, @MA_BITIS_TARIH)
    
    DECLARE @HammaddeCount INT = 0
    DECLARE @MamulCount INT = 0
    DECLARE @ErrorMessage NVARCHAR(4000)
    
    BEGIN TRY
        BEGIN TRANSACTION
        
        -- ============================================================
        -- ADIM 1: Hammadde çıkışlarını güncelle (C+C)
        -- Her kaydın kendi tarihindeki kurla çevrilir
        -- ============================================================
        IF @HEDEF_DOVTIP IS NULL
        BEGIN
            UPDATE h
            SET h.STHAR_DOVFIAT = dbo.fn_MaliyetOto(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH),
                h.STHAR_DOVTIP = dbo.fn_StokDovizTip(h.STOK_KODU)
            FROM dbo.TBLSTHAR h
            WHERE h.STHAR_GCKOD = 'C'
              AND h.STHAR_HTUR = 'C'
              AND h.STHAR_TARIH >= @BASLANGIC_TARIH
              AND h.STHAR_TARIH <= @BITIS_TARIH
        END
        ELSE
        BEGIN
            UPDATE h
            SET h.STHAR_DOVFIAT = dbo.fn_MaliyetCevir(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH, @HEDEF_DOVTIP),
                h.STHAR_DOVTIP = @HEDEF_DOVTIP
            FROM dbo.TBLSTHAR h
            WHERE h.STHAR_GCKOD = 'C'
              AND h.STHAR_HTUR = 'C'
              AND h.STHAR_TARIH >= @BASLANGIC_TARIH
              AND h.STHAR_TARIH <= @BITIS_TARIH
        END
        
        SET @HammaddeCount = @@ROWCOUNT
        
        -- ============================================================
        -- ADIM 2: Mamul girişlerini güncelle (G+C)
        -- ============================================================
        IF @HEDEF_DOVTIP IS NOT NULL
        BEGIN
            ;WITH HammaddeToplam AS (
                SELECT 
                    h.FISNO,
                    CAST(h.STHAR_TARIH AS DATE) AS URETIM_TARIHI,
                    SUM(h.STHAR_GCMIK * ISNULL(h.STHAR_DOVFIAT, 0)) AS HAMMADDE_TOPLAM_MALIYET
                FROM dbo.TBLSTHAR h
                WHERE h.STHAR_GCKOD = 'C'
                  AND h.STHAR_HTUR = 'C'
                  AND h.STHAR_TARIH >= @BASLANGIC_TARIH
                  AND h.STHAR_TARIH <= @BITIS_TARIH
                GROUP BY h.FISNO, CAST(h.STHAR_TARIH AS DATE)
            )
            UPDATE m
            SET m.STHAR_DOVFIAT = CASE 
                    WHEN m.STHAR_GCMIK > 0 
                    THEN ISNULL(ht.HAMMADDE_TOPLAM_MALIYET, 0) / m.STHAR_GCMIK 
                    ELSE 0 
                END,
                m.STHAR_DOVTIP = @HEDEF_DOVTIP
            FROM dbo.TBLSTHAR m
            LEFT JOIN HammaddeToplam ht 
                ON m.FISNO = ht.FISNO 
                AND CAST(m.STHAR_TARIH AS DATE) = ht.URETIM_TARIHI
            WHERE m.STHAR_GCKOD = 'G'
              AND m.STHAR_HTUR = 'C'
              AND m.STHAR_TARIH >= @BASLANGIC_TARIH
              AND m.STHAR_TARIH <= @BITIS_TARIH
        END
        ELSE
        BEGIN
            ;WITH HammaddeDovizTip AS (
                SELECT 
                    h.FISNO,
                    CAST(h.STHAR_TARIH AS DATE) AS URETIM_TARIHI,
                    dbo.fn_StokDovizTip(h.STOK_KODU) AS DOVTIP,
                    COUNT(*) AS KALEM_SAYISI,
                    ROW_NUMBER() OVER (
                        PARTITION BY h.FISNO, CAST(h.STHAR_TARIH AS DATE) 
                        ORDER BY COUNT(*) DESC
                    ) AS RN
                FROM dbo.TBLSTHAR h
                WHERE h.STHAR_GCKOD = 'C'
                  AND h.STHAR_HTUR = 'C'
                  AND h.STHAR_TARIH >= @BASLANGIC_TARIH
                  AND h.STHAR_TARIH <= @BITIS_TARIH
                  AND ISNULL(h.STHAR_DOVFIAT, 0) > 0
                GROUP BY h.FISNO, CAST(h.STHAR_TARIH AS DATE), dbo.fn_StokDovizTip(h.STOK_KODU)
            ),
            EnCokKullanilanDoviz AS (
                SELECT FISNO, URETIM_TARIHI, DOVTIP
                FROM HammaddeDovizTip
                WHERE RN = 1
            ),
            HammaddeToplam AS (
                SELECT 
                    h.FISNO,
                    CAST(h.STHAR_TARIH AS DATE) AS URETIM_TARIHI,
                    eck.DOVTIP AS HEDEF_DOVTIP,
                    SUM(
                        h.STHAR_GCMIK * h.STHAR_DOVFIAT * 
                        CASE 
                            WHEN ISNULL(h.STHAR_DOVTIP, 0) = eck.DOVTIP THEN 1
                            ELSE dbo.fn_Kur(h.STHAR_TARIH, ISNULL(h.STHAR_DOVTIP, 0)) 
                                 / dbo.fn_Kur(h.STHAR_TARIH, eck.DOVTIP)
                        END
                    ) AS HAMMADDE_TOPLAM_MALIYET
                FROM dbo.TBLSTHAR h
                INNER JOIN EnCokKullanilanDoviz eck 
                    ON h.FISNO = eck.FISNO 
                    AND CAST(h.STHAR_TARIH AS DATE) = eck.URETIM_TARIHI
                WHERE h.STHAR_GCKOD = 'C'
                  AND h.STHAR_HTUR = 'C'
                  AND h.STHAR_TARIH >= @BASLANGIC_TARIH
                  AND h.STHAR_TARIH <= @BITIS_TARIH
                GROUP BY h.FISNO, CAST(h.STHAR_TARIH AS DATE), eck.DOVTIP
            )
            UPDATE m
            SET m.STHAR_DOVFIAT = CASE 
                    WHEN m.STHAR_GCMIK > 0 
                    THEN ISNULL(ht.HAMMADDE_TOPLAM_MALIYET, 0) / m.STHAR_GCMIK 
                    ELSE 0 
                END,
                m.STHAR_DOVTIP = ht.HEDEF_DOVTIP
            FROM dbo.TBLSTHAR m
            INNER JOIN HammaddeToplam ht 
                ON m.FISNO = ht.FISNO 
                AND CAST(m.STHAR_TARIH AS DATE) = ht.URETIM_TARIHI
            WHERE m.STHAR_GCKOD = 'G'
              AND m.STHAR_HTUR = 'C'
              AND m.STHAR_TARIH >= @BASLANGIC_TARIH
              AND m.STHAR_TARIH <= @BITIS_TARIH
        END
        
        SET @MamulCount = @@ROWCOUNT
        
        COMMIT TRANSACTION
        
        PRINT '=========================================='
        PRINT 'Üretim Maliyet Güncelleme Tamamlandı'
        PRINT 'Dönem: ' + CAST(@YIL AS VARCHAR) + '/' + RIGHT('0' + CAST(@AY AS VARCHAR), 2)
        PRINT 'Döviz Modu: ' + CASE 
            WHEN @HEDEF_DOVTIP IS NULL THEN 'DİNAMİK (J girişinden)' 
            ELSE dbo.fn_DovizAdi(@HEDEF_DOVTIP) 
        END
        PRINT 'MA Tarih Aralığı: ' + CONVERT(VARCHAR, @MA_BASLANGIC_TARIH, 104) + ' - ' + CONVERT(VARCHAR, @MA_BITIS_TARIH, 104)
        PRINT 'Güncellenen Hammadde: ' + CAST(@HammaddeCount AS VARCHAR)
        PRINT 'Güncellenen Mamul: ' + CAST(@MamulCount AS VARCHAR)
        PRINT '=========================================='
        
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION
        
        SET @ErrorMessage = ERROR_MESSAGE()
        RAISERROR(@ErrorMessage, 16, 1)
    END CATCH
END
GO

-- ============================================================
-- BÖLÜM 5: TEST PROSEDÜRÜ
-- ============================================================

CREATE PROCEDURE dbo.sp_UretimMaliyetTest
    @YIL INT,
    @AY INT,
    @HEDEF_DOVTIP TINYINT = NULL,
    @MA_BASLANGIC_TARIH DATETIME = NULL
AS
BEGIN
    SET NOCOUNT ON;
    
    DECLARE @BASLANGIC_TARIH DATETIME = DATEFROMPARTS(@YIL, @AY, 1)
    DECLARE @BITIS_TARIH DATETIME = EOMONTH(@BASLANGIC_TARIH)
    DECLARE @MA_BITIS_TARIH DATETIME = DATEADD(DAY, -1, @BASLANGIC_TARIH)
    
    IF @MA_BASLANGIC_TARIH IS NULL
        SET @MA_BASLANGIC_TARIH = DATEADD(YEAR, -1, @MA_BITIS_TARIH)
    
    PRINT '=========================================='
    PRINT 'TEST MODU'
    PRINT 'Dönem: ' + CAST(@YIL AS VARCHAR) + '/' + RIGHT('0' + CAST(@AY AS VARCHAR), 2)
    PRINT 'Döviz Modu: ' + CASE 
        WHEN @HEDEF_DOVTIP IS NULL THEN 'DİNAMİK (J girişinden)' 
        ELSE dbo.fn_DovizAdi(@HEDEF_DOVTIP) 
    END
    PRINT 'MA Tarih Aralığı: ' + CONVERT(VARCHAR, @MA_BASLANGIC_TARIH, 104) + ' - ' + CONVERT(VARCHAR, @MA_BITIS_TARIH, 104)
    PRINT '=========================================='
    
    -- HAMMADDE ÇIKIŞLARI
    PRINT ''
    PRINT '>>> HAMMADDE ÇIKIŞLARI (C+C)'
    
    SELECT 
        h.INCKEYNO,
        h.FISNO,
        h.STOK_KODU,
        h.STHAR_TARIH,
        h.STHAR_GCMIK AS MIKTAR,
        h.STHAR_DOVTIP AS MEVCUT_DOVTIP,
        dbo.fn_DovizAdi(ISNULL(h.STHAR_DOVTIP, 0)) AS MEVCUT_DOVIZ,
        h.STHAR_DOVFIAT AS MEVCUT_FIYAT,
        h.STHAR_NF AS TL_TUTAR,
        dbo.fn_StokDovizTip(h.STOK_KODU) AS J_DOVTIP,
        dbo.fn_DovizAdi(dbo.fn_StokDovizTip(h.STOK_KODU)) AS J_DOVIZ,
        CASE 
            WHEN @HEDEF_DOVTIP IS NULL THEN dbo.fn_StokDovizTip(h.STOK_KODU)
            ELSE @HEDEF_DOVTIP 
        END AS YENI_DOVTIP,
        CASE 
            WHEN @HEDEF_DOVTIP IS NULL THEN dbo.fn_DovizAdi(dbo.fn_StokDovizTip(h.STOK_KODU))
            ELSE dbo.fn_DovizAdi(@HEDEF_DOVTIP) 
        END AS YENI_DOVIZ,
        CASE 
            WHEN @HEDEF_DOVTIP IS NULL 
            THEN dbo.fn_MaliyetOto(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH)
            ELSE dbo.fn_MaliyetCevir(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH, @HEDEF_DOVTIP)
        END AS YENI_FIYAT,
        dbo.fn_Kur(h.STHAR_TARIH, 1) AS EUR_KUR,
        dbo.fn_Kur(h.STHAR_TARIH, 2) AS USD_KUR
    FROM dbo.TBLSTHAR h
    WHERE h.STHAR_GCKOD = 'C'
      AND h.STHAR_HTUR = 'C'
      AND h.STHAR_TARIH >= @BASLANGIC_TARIH
      AND h.STHAR_TARIH <= @BITIS_TARIH
    ORDER BY h.FISNO, h.STHAR_TARIH
    
    -- MAMUL GİRİŞLERİ
    PRINT ''
    PRINT '>>> MAMUL GİRİŞLERİ (G+C)'
    
    IF @HEDEF_DOVTIP IS NOT NULL
    BEGIN
        ;WITH HammaddeToplam AS (
            SELECT 
                h.FISNO,
                CAST(h.STHAR_TARIH AS DATE) AS URETIM_TARIHI,
                SUM(h.STHAR_GCMIK * dbo.fn_MaliyetCevir(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH, @HEDEF_DOVTIP)) AS HAMMADDE_TOPLAM,
                COUNT(*) AS KALEM
            FROM dbo.TBLSTHAR h
            WHERE h.STHAR_GCKOD = 'C'
              AND h.STHAR_HTUR = 'C'
              AND h.STHAR_TARIH >= @BASLANGIC_TARIH
              AND h.STHAR_TARIH <= @BITIS_TARIH
            GROUP BY h.FISNO, CAST(h.STHAR_TARIH AS DATE)
        )
        SELECT 
            m.INCKEYNO,
            m.FISNO,
            m.STOK_KODU AS MAMUL_KODU,
            m.STHAR_TARIH,
            m.STHAR_GCMIK AS URETIM_MIKTARI,
            m.STHAR_DOVTIP AS MEVCUT_DOVTIP,
            dbo.fn_DovizAdi(ISNULL(m.STHAR_DOVTIP, 0)) AS MEVCUT_DOVIZ,
            m.STHAR_DOVFIAT AS MEVCUT_BIRIM_FIYAT,
            @HEDEF_DOVTIP AS YENI_DOVTIP,
            dbo.fn_DovizAdi(@HEDEF_DOVTIP) AS YENI_DOVIZ,
            CASE WHEN m.STHAR_GCMIK > 0 THEN ISNULL(ht.HAMMADDE_TOPLAM, 0) / m.STHAR_GCMIK ELSE 0 END AS YENI_BIRIM_FIYAT,
            ISNULL(ht.HAMMADDE_TOPLAM, 0) AS HAMMADDE_TOPLAM,
            ISNULL(ht.KALEM, 0) AS HAMMADDE_KALEM
        FROM dbo.TBLSTHAR m
        LEFT JOIN HammaddeToplam ht 
            ON m.FISNO = ht.FISNO 
            AND CAST(m.STHAR_TARIH AS DATE) = ht.URETIM_TARIHI
        WHERE m.STHAR_GCKOD = 'G'
          AND m.STHAR_HTUR = 'C'
          AND m.STHAR_TARIH >= @BASLANGIC_TARIH
          AND m.STHAR_TARIH <= @BITIS_TARIH
        ORDER BY m.FISNO, m.STHAR_TARIH
    END
    ELSE
    BEGIN
        ;WITH HammaddeDovizTip AS (
            SELECT 
                h.FISNO,
                CAST(h.STHAR_TARIH AS DATE) AS URETIM_TARIHI,
                dbo.fn_StokDovizTip(h.STOK_KODU) AS DOVTIP,
                COUNT(*) AS KALEM_SAYISI,
                ROW_NUMBER() OVER (
                    PARTITION BY h.FISNO, CAST(h.STHAR_TARIH AS DATE) 
                    ORDER BY COUNT(*) DESC
                ) AS RN
            FROM dbo.TBLSTHAR h
            WHERE h.STHAR_GCKOD = 'C'
              AND h.STHAR_HTUR = 'C'
              AND h.STHAR_TARIH >= @BASLANGIC_TARIH
              AND h.STHAR_TARIH <= @BITIS_TARIH
              AND dbo.fn_MaliyetOto(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH) > 0
            GROUP BY h.FISNO, CAST(h.STHAR_TARIH AS DATE), dbo.fn_StokDovizTip(h.STOK_KODU)
        ),
        EnCokKullanilanDoviz AS (
            SELECT FISNO, URETIM_TARIHI, DOVTIP
            FROM HammaddeDovizTip
            WHERE RN = 1
        ),
        HammaddeToplam AS (
            SELECT 
                h.FISNO,
                CAST(h.STHAR_TARIH AS DATE) AS URETIM_TARIHI,
                eck.DOVTIP AS HEDEF_DOVTIP,
                SUM(
                    h.STHAR_GCMIK * 
                    dbo.fn_MaliyetOto(h.STOK_KODU, @MA_BASLANGIC_TARIH, @MA_BITIS_TARIH) * 
                    CASE 
                        WHEN dbo.fn_StokDovizTip(h.STOK_KODU) = eck.DOVTIP THEN 1
                        ELSE dbo.fn_Kur(h.STHAR_TARIH, dbo.fn_StokDovizTip(h.STOK_KODU)) 
                             / dbo.fn_Kur(h.STHAR_TARIH, eck.DOVTIP)
                    END
                ) AS HAMMADDE_TOPLAM,
                COUNT(*) AS KALEM
            FROM dbo.TBLSTHAR h
            INNER JOIN EnCokKullanilanDoviz eck 
                ON h.FISNO = eck.FISNO 
                AND CAST(h.STHAR_TARIH AS DATE) = eck.URETIM_TARIHI
            WHERE h.STHAR_GCKOD = 'C'
              AND h.STHAR_HTUR = 'C'
              AND h.STHAR_TARIH >= @BASLANGIC_TARIH
              AND h.STHAR_TARIH <= @BITIS_TARIH
            GROUP BY h.FISNO, CAST(h.STHAR_TARIH AS DATE), eck.DOVTIP
        )
        SELECT 
            m.INCKEYNO,
            m.FISNO,
            m.STOK_KODU AS MAMUL_KODU,
            m.STHAR_TARIH,
            m.STHAR_GCMIK AS URETIM_MIKTARI,
            m.STHAR_DOVTIP AS MEVCUT_DOVTIP,
            dbo.fn_DovizAdi(ISNULL(m.STHAR_DOVTIP, 0)) AS MEVCUT_DOVIZ,
            m.STHAR_DOVFIAT AS MEVCUT_BIRIM_FIYAT,
            ht.HEDEF_DOVTIP AS YENI_DOVTIP,
            dbo.fn_DovizAdi(ISNULL(ht.HEDEF_DOVTIP, 0)) AS YENI_DOVIZ,
            CASE WHEN m.STHAR_GCMIK > 0 THEN ISNULL(ht.HAMMADDE_TOPLAM, 0) / m.STHAR_GCMIK ELSE 0 END AS YENI_BIRIM_FIYAT,
            ISNULL(ht.HAMMADDE_TOPLAM, 0) AS HAMMADDE_TOPLAM,
            ISNULL(ht.KALEM, 0) AS HAMMADDE_KALEM
        FROM dbo.TBLSTHAR m
        LEFT JOIN HammaddeToplam ht 
            ON m.FISNO = ht.FISNO 
            AND CAST(m.STHAR_TARIH AS DATE) = ht.URETIM_TARIHI
        WHERE m.STHAR_GCKOD = 'G'
          AND m.STHAR_HTUR = 'C'
          AND m.STHAR_TARIH >= @BASLANGIC_TARIH
          AND m.STHAR_TARIH <= @BITIS_TARIH
        ORDER BY m.FISNO, m.STHAR_TARIH
    END
END
