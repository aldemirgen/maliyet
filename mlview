-- ============================================================
-- TÜM STOKLAR İÇİN WMA LİSTESİ
-- ============================================================

DECLARE @TARIH DATETIME = GETDATE()  -- İstediğin tarihi değiştir

SELECT 
    st.STOK_KODU,
    st.STOK_ADI,
    -- Mevcut Bakiye
    ISNULL((
        SELECT SUM(CASE WHEN STHAR_GCKOD = 'G' THEN STHAR_GCMIK ELSE -STHAR_GCMIK END)
        FROM TBLSTHAR 
        WHERE STOK_KODU = st.STOK_KODU 
          AND STHAR_TARIH <= @TARIH
          AND STHAR_HTUR IN ('C', 'J', 'D', 'B')
    ), 0) AS BAKIYE,
    -- Döviz bilgisi
    dbo.fn_StokDovizTip(st.STOK_KODU) AS DOVTIP,
    dbo.fn_DovizAdi(dbo.fn_StokDovizTip(st.STOK_KODU)) AS DOVIZ,
    -- WMA değerleri
    dbo.fn_WMA(st.STOK_KODU, @TARIH, NULL) AS WMA_ORIJINAL,
    dbo.fn_WMA_EUR(st.STOK_KODU, @TARIH) AS WMA_EUR,
    dbo.fn_WMA_Cevir(st.STOK_KODU, @TARIH, 2) AS WMA_USD,
    dbo.fn_WMA_Cevir(st.STOK_KODU, @TARIH, 0) AS WMA_TL,
    -- Stok Değeri (Bakiye × WMA)
    ISNULL((
        SELECT SUM(CASE WHEN STHAR_GCKOD = 'G' THEN STHAR_GCMIK ELSE -STHAR_GCMIK END)
        FROM TBLSTHAR 
        WHERE STOK_KODU = st.STOK_KODU 
          AND STHAR_TARIH <= @TARIH
          AND STHAR_HTUR IN ('C', 'J', 'D', 'B')
    ), 0) * dbo.fn_WMA_EUR(st.STOK_KODU, @TARIH) AS STOK_DEGERI_EUR
FROM TBLSTSABIT st
WHERE EXISTS (
    SELECT 1 FROM TBLSTHAR h 
    WHERE h.STOK_KODU = st.STOK_KODU 
      AND h.STHAR_TARIH <= @TARIH
      AND h.STHAR_HTUR IN ('C', 'J', 'D', 'B')
)
ORDER BY st.STOK_KODU


