-- Belirli bir stok için MA hesabının detayını göster
DECLARE @STOK_MA VARCHAR(50) = 'STOK_KODU_BURAYA'
DECLARE @BAS_MA DATETIME = '2025-01-01'
DECLARE @BIT_MA DATETIME = '2025-12-31'

-- G+J Girişleri (MA hesabına dahil olan kayıtlar)
SELECT 
    'MA GİRİŞ' AS TIP,
    INCKEYNO,
    FISNO,
    STHAR_TARIH AS TARIH,
    STHAR_GCMIK AS MIKTAR,
    ISNULL(STHAR_DOVTIP, 0) AS DOVTIP,
    dbo.fn_DovizAdi(ISNULL(STHAR_DOVTIP, 0)) AS DOVIZ,
    STHAR_DOVFIAT AS DOVFIAT,
    STHAR_NF AS NF,
    -- Kullanılan birim fiyat
    CASE 
        WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT
        WHEN ISNULL(STHAR_NF, 0) > 0 THEN STHAR_NF / STHAR_GCMIK
        ELSE 0
    END AS KULLANILAN_BIRIM_FIYAT,
    -- Toplam değer
    STHAR_GCMIK * CASE 
        WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT
        WHEN ISNULL(STHAR_NF, 0) > 0 THEN STHAR_NF / STHAR_GCMIK
        ELSE 0
    END AS TOPLAM_DEGER,
    -- EUR'a çevrilmiş
    STHAR_GCMIK * CASE ISNULL(STHAR_DOVTIP, 0)
        WHEN 0 THEN 
            CASE 
                WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT / dbo.fn_Kur(STHAR_TARIH, 1)
                WHEN ISNULL(STHAR_NF, 0) > 0 THEN (STHAR_NF / STHAR_GCMIK) / dbo.fn_Kur(STHAR_TARIH, 1)
                ELSE 0
            END
        WHEN 1 THEN STHAR_DOVFIAT
        WHEN 2 THEN STHAR_DOVFIAT * dbo.fn_Parite(STHAR_TARIH, 2, 1)
    END AS EUR_DEGER,
    dbo.fn_Kur(STHAR_TARIH, 1) AS EUR_KUR,
    dbo.fn_Kur(STHAR_TARIH, 2) AS USD_KUR
FROM TBLSTHAR
WHERE STOK_KODU = @STOK_MA
  AND STHAR_GCKOD = 'G'
  AND STHAR_HTUR = 'J'
  AND STHAR_TARIH >= @BAS_MA
  AND STHAR_TARIH <= @BIT_MA
  AND STHAR_GCMIK > 0
  AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)
ORDER BY STHAR_TARIH

-- MA Özet
SELECT 
    'MA ÖZET' AS TIP,
    COUNT(*) AS KAYIT_SAYISI,
    SUM(STHAR_GCMIK) AS TOPLAM_MIKTAR,
    -- Orijinal dövizde
    dbo.fn_StokDovizTip(@STOK_MA) AS STOK_DOVTIP,
    dbo.fn_DovizAdi(dbo.fn_StokDovizTip(@STOK_MA)) AS STOK_DOVIZ,
    dbo.fn_MaliyetOto(@STOK_MA, @BAS_MA, @BIT_MA) AS MA_ORIJINAL,
    -- Çevrilmiş
    dbo.fn_MaliyetEUR(@STOK_MA, @BAS_MA, @BIT_MA) AS MA_EUR,
    dbo.fn_MaliyetCevir(@STOK_MA, @BAS_MA, @BIT_MA, 2) AS MA_USD,
    dbo.fn_MaliyetCevir(@STOK_MA, @BAS_MA, @BIT_MA, 0) AS MA_TL
FROM TBLSTHAR
WHERE STOK_KODU = @STOK_MA
  AND STHAR_GCKOD = 'G'
  AND STHAR_HTUR = 'J'
  AND STHAR_TARIH >= @BAS_MA
  AND STHAR_TARIH <= @BIT_MA
  AND STHAR_GCMIK > 0
  AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)

