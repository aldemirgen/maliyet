-- ============================================================
-- BÖLÜM 1: KUR FONKSİYONLARI
-- ============================================================

CREATE FUNCTION dbo.fn_Kur
(
    @TARIH DATETIME,
    @DOVTIP TINYINT  -- 0:TL, 1:EUR, 2:USD
)
RETURNS DECIMAL(28, 10)
AS
BEGIN
    DECLARE @Result DECIMAL(28, 10) = 1
    
    IF @DOVTIP = 0
        RETURN 1
    
    SELECT TOP 1 @Result = DOV_ALIS
    FROM NETSIS.dbo.DOVIZ
    WHERE SIRA = @DOVTIP
      AND TARIH <= @TARIH
      AND DOV_ALIS > 0
    ORDER BY TARIH DESC
    
    IF @Result IS NULL OR @Result = 0
    BEGIN
        SELECT TOP 1 @Result = DOV_ALIS
        FROM NETSIS.dbo.DOVIZ
        WHERE SIRA = @DOVTIP
          AND DOV_ALIS > 0
        ORDER BY TARIH ASC
    END
    
    RETURN ISNULL(@Result, 1)
END
GO

CREATE FUNCTION dbo.fn_Parite
(
    @TARIH DATETIME,
    @KAYNAK_DOVTIP TINYINT,
    @HEDEF_DOVTIP TINYINT
)
RETURNS DECIMAL(28, 10)
AS
BEGIN
    DECLARE @KaynakKur DECIMAL(28, 10)
    DECLARE @HedefKur DECIMAL(28, 10)
    
    SET @KaynakKur = dbo.fn_Kur(@TARIH, @KAYNAK_DOVTIP)
    SET @HedefKur = dbo.fn_Kur(@TARIH, @HEDEF_DOVTIP)
    
    IF @HedefKur = 0
        RETURN 1
    
    RETURN @KaynakKur / @HedefKur
END
GO

-- ============================================================
-- BÖLÜM 2: DÖVİZ FONKSİYONLARI
-- ============================================================

CREATE FUNCTION dbo.fn_DovizAdi(@DOVTIP TINYINT)
RETURNS VARCHAR(3)
AS
BEGIN
    RETURN CASE @DOVTIP
        WHEN 0 THEN 'TL'
        WHEN 1 THEN 'EUR'
        WHEN 2 THEN 'USD'
        ELSE 'TL'
    END
END
GO

CREATE FUNCTION dbo.fn_StokDovizTip
(
    @STOK_KODU VARCHAR(50)
)
RETURNS TINYINT
AS
BEGIN
    DECLARE @Result TINYINT = 0
    
    SELECT TOP 1 @Result = ISNULL(STHAR_DOVTIP, 0)
    FROM dbo.TBLSTHAR
    WHERE STOK_KODU = @STOK_KODU
      AND STHAR_GCKOD = 'G'
      AND STHAR_HTUR = 'J'
      AND STHAR_GCMIK > 0
    ORDER BY STHAR_TARIH DESC
    
    RETURN @Result
END
GO

-- ============================================================
-- BÖLÜM 3: MALİYET FONKSİYONLARI (Moving Average)
-- ============================================================

-- ============================================================
-- 3.1 ANA MALİYET FONKSİYONU
-- 
-- Belirtilen döviz tipindeki G+J girişlerinin MA'sını hesaplar
-- DOVFIAT=0 ve NF>0 olan kayıtlarda NF/GCMIK kullanılır
--
-- @STOK_KODU  : Stok kodu
-- @BASLANGIC  : Bu tarihten itibaren (>=)
-- @BITIS      : Bu tarihe kadar (<=)
-- @DOVTIP     : Döviz tipi (0:TL, 1:EUR, 2:USD)
-- ============================================================
CREATE FUNCTION dbo.fn_Maliyet
(
    @STOK_KODU VARCHAR(50),
    @BASLANGIC DATETIME,
    @BITIS DATETIME,
    @DOVTIP TINYINT = 0
)
RETURNS DECIMAL(28, 15)
AS
BEGIN
    DECLARE @Result DECIMAL(28, 15) = 0
    
    -- Ana hesaplama
    -- DOVTIP=0 (TL) için: DOVFIAT > 0 ise DOVFIAT, değilse NF/GCMIK
    -- Diğer dövizler için: DOVFIAT
    SELECT @Result = 
        CASE 
            WHEN SUM(STHAR_GCMIK) > 0 
            THEN SUM(STHAR_GCMIK * 
                CASE 
                    WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT
                    WHEN @DOVTIP = 0 AND ISNULL(STHAR_NF, 0) > 0 THEN STHAR_NF / STHAR_GCMIK
                    ELSE 0
                END
            ) / SUM(STHAR_GCMIK)
            ELSE 0 
        END
    FROM dbo.TBLSTHAR
    WHERE STOK_KODU = @STOK_KODU
      AND STHAR_GCKOD = 'G'
      AND STHAR_HTUR = 'J'
      AND STHAR_TARIH >= @BASLANGIC
      AND STHAR_TARIH <= @BITIS
      AND STHAR_GCMIK > 0
      AND ISNULL(STHAR_DOVTIP, 0) = @DOVTIP
      AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR (@DOVTIP = 0 AND ISNULL(STHAR_NF, 0) > 0))
    
    -- Fallback 1: Aralıkta bulunamadıysa, aralıktaki son girişi al
    IF ISNULL(@Result, 0) = 0
    BEGIN
        SELECT TOP 1 @Result = 
            CASE 
                WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT
                WHEN @DOVTIP = 0 AND ISNULL(STHAR_NF, 0) > 0 THEN STHAR_NF / STHAR_GCMIK
                ELSE 0
            END
        FROM dbo.TBLSTHAR
        WHERE STOK_KODU = @STOK_KODU
          AND STHAR_GCKOD = 'G'
          AND STHAR_HTUR = 'J'
          AND STHAR_TARIH >= @BASLANGIC
          AND STHAR_TARIH <= @BITIS
          AND STHAR_GCMIK > 0
          AND ISNULL(STHAR_DOVTIP, 0) = @DOVTIP
          AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR (@DOVTIP = 0 AND ISNULL(STHAR_NF, 0) > 0))
        ORDER BY STHAR_TARIH DESC
    END
    
    -- Fallback 2: Aralıktan önceki son girişi al
    IF ISNULL(@Result, 0) = 0
    BEGIN
        SELECT TOP 1 @Result = 
            CASE 
                WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT
                WHEN @DOVTIP = 0 AND ISNULL(STHAR_NF, 0) > 0 THEN STHAR_NF / STHAR_GCMIK
                ELSE 0
            END
        FROM dbo.TBLSTHAR
        WHERE STOK_KODU = @STOK_KODU
          AND STHAR_GCKOD = 'G'
          AND STHAR_HTUR = 'J'
          AND STHAR_TARIH < @BASLANGIC
          AND STHAR_GCMIK > 0
          AND ISNULL(STHAR_DOVTIP, 0) = @DOVTIP
          AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR (@DOVTIP = 0 AND ISNULL(STHAR_NF, 0) > 0))
        ORDER BY STHAR_TARIH DESC
    END
    
    -- Fallback 3: Herhangi dövizde son girişi al
    IF ISNULL(@Result, 0) = 0
    BEGIN
        SELECT TOP 1 @Result = 
            CASE 
                WHEN ISNULL(STHAR_DOVFIAT, 0) > 0 THEN STHAR_DOVFIAT
                WHEN ISNULL(STHAR_NF, 0) > 0 THEN STHAR_NF / STHAR_GCMIK
                ELSE 0
            END
        FROM dbo.TBLSTHAR
        WHERE STOK_KODU = @STOK_KODU
          AND STHAR_GCKOD = 'G'
          AND STHAR_HTUR = 'J'
          AND STHAR_GCMIK > 0
          AND (ISNULL(STHAR_DOVFIAT, 0) > 0 OR ISNULL(STHAR_NF, 0) > 0)
        ORDER BY STHAR_TARIH DESC
    END
    
    RETURN ISNULL(@Result, 0)
END
GO

